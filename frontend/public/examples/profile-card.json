{
  "component": { "name": "ProfileCard" },
  "state": [
    { "name": "isFollowing", "initial": "false" },
    { "name": "likes", "initial": "1240" }
  ],
  "ui": {
    "type": "div",
    "className": "max-w-sm mx-auto bg-white dark:bg-gray-800 rounded-3xl shadow-xl overflow-hidden mt-10 border border-gray-100 dark:border-gray-700",
    "children": [
      {
        "type": "div",
        "className": "h-32 bg-gradient-to-r from-cyan-500 to-blue-500 relative",
        "children": [
          {
            "type": "img",
            "className": "w-24 h-24 rounded-full border-4 border-white dark:border-gray-800 absolute -bottom-12 left-1/2 transform -translate-x-1/2 object-cover bg-white",
            "props": { "src": "https://api.dicebear.com/7.x/avataaars/svg?seed=Felix", "alt": "Avatar" }
          }
        ]
      },
      {
        "type": "div",
        "className": "pt-16 pb-6 px-6 text-center",
        "children": [
          { "type": "h2", "className": "text-xl font-bold text-gray-900 dark:text-white", "text": "Felix UI" },
          { "type": "p", "className": "text-sm text-gray-500 dark:text-gray-400 mb-4", "text": "Frontend Developer & Designer" },
          {
            "type": "div",
            "className": "flex justify-center gap-6 mb-6 text-center",
            "children": [
              {
                "type": "div",
                "children": [
                  { "type": "div", "className": "font-bold text-gray-900 dark:text-white", "text": "45" },
                  { "type": "div", "className": "text-xs text-gray-500 font-medium uppercase tracking-wide", "text": "Projects" }
                ]
              },
              {
                "type": "div",
                "children": [
                  { "type": "div", "className": "font-bold text-gray-900 dark:text-white", "text": "{likes}" },
                  { "type": "div", "className": "text-xs text-gray-500 font-medium uppercase tracking-wide", "text": "Likes" }
                ]
              }
            ]
          },
          {
            "type": "div",
            "className": "flex gap-3 justify-center",
            "children": [
              { "type": "button", "className": "{`px-6 py-2 rounded-full font-medium transition-all ${isFollowing ? 'bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-200' : 'bg-blue-600 text-white hover:bg-blue-700 hover:shadow-lg hover:shadow-blue-600/30'}`}", "onClick": "() => setIsFollowing(!isFollowing)", "label": "{isFollowing ? 'Following' : 'Follow'}" },
              { "type": "button", "className": "px-6 py-2 rounded-full font-medium bg-red-50 text-red-600 dark:bg-red-900/20 dark:text-red-400 hover:bg-red-100 dark:hover:bg-red-900/40 transition-colors", "onClick": "() => setLikes(l => l + 1)", "label": "🤍 Like" }
            ]
          }
        ]
      }
    ]
  }
}